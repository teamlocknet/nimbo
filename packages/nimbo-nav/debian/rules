#!/usr/bin/make -f

export PYBUILD_NAME=nimbo-nav
export PYBUILD_SYSTEM=pyproject
export PYBUILD_TEST_PYTEST=1
# pybuild corre las pruebas en una copia sin config/ ni debian/: les dice dónde está la fuente
export NIMBO_NAV_SRC=$(CURDIR)

%:
	dh $@ --with python3 --buildsystem=pybuild

# La unidad no tiene [Install]: no se habilita ni se arranca al instalar.
override_dh_installsystemd:
	dh_installsystemd --no-enable --no-start
