#!/usr/sbin/nft -f
# nimbo-tor.nft — tabla del MODO TOR (ADR-012, decisión D2). La carga `nimbo-tor on` y la
# borra `nimbo-tor off`; fuera del modo Tor no existe.
#
# Falla cerrada: solo puede salir el usuario debian-tor (el proceso tor) y el loopback
# (navegador -> SOCKS 127.0.0.1:9050). Todo lo demás se CUENTA en "fugas" y se descarta.
# nimbo-leakcheck lee ese contador: si sube, hay un intento de fuga y avisa al usuario.
#
# Excepción explícita, sin contar como fuga (revisión de #44): el tráfico de puesta en
# marcha de la NIC que ya admite el criterio de hermetismo — DHCPv4 y NDP/MLD de IPv6
# link-local. ARP no pasa por una tabla inet.
#
# Sin "ct state established accept": dejaría salir conexiones abiertas antes del modo Tor.
#
# Conexiones de tor y paquetes sin dueño (ensayo de la demo, 18-nov): cuando una conexión de tor
# se cierra, el RST lo genera el KERNEL, sin proceso dueño, y "meta skuid" no lo reconoce (igual
# con los ICMP de error del kernel). Por eso tor MARCA en conntrack las conexiones que abre
# (0x6e74, "nt") y se aceptan los paquetes de una conexión marcada aunque no tengan dueño. Una
# conexión de otro usuario, o abierta antes del modo Tor, no tiene la marca: sigue siendo fuga.
#
# ICMP de error a tráfico entrante (observación de #84, medido el 18-nov): si otro equipo manda
# un paquete a un puerto cerrado, el kernel contesta "inalcanzable", sin dueño ni marca (la
# conexión la empezó el otro). Se acepta solo ese ICMP de error, en dirección de RESPUESTA a una
# conexión que vino de fuera: el otro ya conoce nuestra IP. Un ICMP de una conexión abierta
# desde aquí va en dirección original y sigue contando; las respuestas con datos y los RST, también.

table inet nimbo_tor
delete table inet nimbo_tor

table inet nimbo_tor {
	counter fugas {
	}

	chain salida {
		type filter hook output priority filter; policy drop;

		oif "lo" accept
		meta skuid "debian-tor" ct mark set 0x6e74 accept
		ct mark 0x6e74 accept
		ct direction reply ct state related meta l4proto { icmp, ipv6-icmp } accept

		udp sport 68 udp dport 67 accept
		icmpv6 type { nd-router-solicit, nd-neighbor-solicit, nd-neighbor-advert, mld2-listener-report } ip6 daddr { ff02::/16, fe80::/10 } accept

		log prefix "nimbo-fuga " level warn counter name "fugas" drop
	}
}
